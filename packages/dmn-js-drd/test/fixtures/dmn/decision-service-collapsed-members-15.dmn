<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20230324/MODEL/"
             xmlns:dmndi="https://www.omg.org/spec/DMN/20230324/DMNDI/"
             xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/"
             xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/"
             id="Definitions_DecisionServiceCollapsed"
             name="Decision Service Collapsed"
             namespace="https://example.com/dmn15/decision-service-collapsed">
  <decision id="Decision_Output" name="Output Decision">
    <informationRequirement id="InformationRequirement_Output">
      <requiredDecision href="#Decision_Encapsulated" />
    </informationRequirement>
  </decision>
  <decision id="Decision_Encapsulated" name="Encapsulated Decision" />
  <decisionService id="DecisionService_Approval" name="Approval Service">
    <outputDecision href="#Decision_Output" />
    <encapsulatedDecision href="#Decision_Encapsulated" />
  </decisionService>
  <dmndi:DMNDI>
    <dmndi:DMNDiagram id="DMNDiagram_DecisionServiceCollapsed">
      <!-- Drawn collapsed, yet the members keep their shapes: the specification
           describes the collapsed form through a second DRD that simply omits them
           (§6.2.4) but states no rule against this, so a document may well arrive
           this way. The decisions sit far below the small box. -->
      <dmndi:DMNShape id="DMNShape_DecisionService_Approval" dmnElementRef="DecisionService_Approval" isCollapsed="true">
        <dc:Bounds x="100" y="80" width="180" height="100" />
        <dmndi:DMNDecisionServiceDividerLine>
          <di:waypoint x="100" y="160" />
          <di:waypoint x="280" y="160" />
        </dmndi:DMNDecisionServiceDividerLine>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="DMNShape_Decision_Output" dmnElementRef="Decision_Output">
        <dc:Bounds x="120" y="300" width="120" height="50" />
      </dmndi:DMNShape>
      <dmndi:DMNShape id="DMNShape_Decision_Encapsulated" dmnElementRef="Decision_Encapsulated">
        <dc:Bounds x="120" y="420" width="120" height="50" />
      </dmndi:DMNShape>
      <dmndi:DMNEdge id="DMNEdge_InformationRequirement_Output" dmnElementRef="InformationRequirement_Output">
        <di:waypoint x="180" y="420" />
        <di:waypoint x="180" y="350" />
      </dmndi:DMNEdge>
    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
</definitions>
