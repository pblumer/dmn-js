<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20230324/MODEL/"
             xmlns:dmndi="https://www.omg.org/spec/DMN/20230324/DMNDI/"
             xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/"
             xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/"
             id="Definitions_DecisionServiceInputs"
             name="Decision Service Inputs"
             namespace="https://example.com/dmn15/decision-service-inputs">
  <inputData id="InputData_Age" name="Applicant Age" />
  <decision id="Decision_Eligibility" name="Eligibility" />
  <decision id="Decision_Routing" name="Routing" />
  <decisionService id="DecisionService_Approval" name="Approval" />
  <dmndi:DMNDI>
    <dmndi:DMNDiagram id="DMNDiagram_DecisionServiceInputs">
      <dmndi:DMNShape id="DMNShape_DecisionService_Approval" dmnElementRef="DecisionService_Approval">
        <dc:Bounds x="100" y="80" width="360" height="300" />
        <dmndi:DMNDecisionServiceDividerLine>
          <di:waypoint x="100" y="220" />
          <di:waypoint x="460" y="220" />
        </dmndi:DMNDecisionServiceDividerLine>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="DMNShape_Decision_Routing" dmnElementRef="Decision_Routing">
        <dc:Bounds x="560" y="100" width="180" height="80" />
      </dmndi:DMNShape>
      <dmndi:DMNShape id="DMNShape_Decision_Eligibility" dmnElementRef="Decision_Eligibility">
        <dc:Bounds x="560" y="260" width="180" height="80" />
      </dmndi:DMNShape>
      <dmndi:DMNShape id="DMNShape_InputData_Age" dmnElementRef="InputData_Age">
        <dc:Bounds x="560" y="390" width="125" height="45" />
      </dmndi:DMNShape>
    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
</definitions>
