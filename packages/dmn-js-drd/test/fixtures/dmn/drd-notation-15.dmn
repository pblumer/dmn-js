<?xml version="1.0" encoding="UTF-8"?>
<!--
  One diagram holding every element the DRD notation defines, so a test can read the
  drawn shape of each back and hold it against DMN 1.5 Table 5-2.

  The input datum is 125x60 on purpose. The default is 125x45, and a corner radius
  hard-coded for that height draws a stadium by coincidence rather than by rule — a
  size the default does not cover is what tells the two apart.
-->
<definitions xmlns="https://www.omg.org/spec/DMN/20230324/MODEL/"
             xmlns:dmndi="https://www.omg.org/spec/DMN/20230324/DMNDI/"
             xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/"
             xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/"
             id="Definitions_DrdNotation"
             name="DRD Notation"
             namespace="https://example.com/dmn15/drd-notation">
  <inputData id="InputData_Amount" name="Amount">
    <variable id="Variable_Amount" name="amount" typeRef="number" />
  </inputData>
  <businessKnowledgeModel id="BKM_Instalment" name="Instalment" />
  <knowledgeSource id="KnowledgeSource_Policy" name="Lending Policy" />
  <decision id="Decision_Approval" name="Approval" />
  <decision id="Decision_Risk" name="Risk">
    <informationRequirement id="InformationRequirement_Amount">
      <requiredInput href="#InputData_Amount" />
    </informationRequirement>
  </decision>
  <decision id="Decision_Standalone" name="Standalone">
    <knowledgeRequirement id="KnowledgeRequirement_Instalment">
      <requiredKnowledge href="#BKM_Instalment" />
    </knowledgeRequirement>
    <authorityRequirement id="AuthorityRequirement_Policy">
      <requiredAuthority href="#KnowledgeSource_Policy" />
    </authorityRequirement>
  </decision>
  <decisionService id="DecisionService_Approval" name="Approval Service">
    <outputDecision href="#Decision_Approval" />
    <encapsulatedDecision href="#Decision_Risk" />
  </decisionService>
  <textAnnotation id="TextAnnotation_Note">
    <text>Reviewed quarterly</text>
  </textAnnotation>
  <association id="Association_Note">
    <sourceRef href="#Decision_Standalone" />
    <targetRef href="#TextAnnotation_Note" />
  </association>
  <dmndi:DMNDI>
    <dmndi:DMNDiagram id="DMNDiagram_DrdNotation">
      <dmndi:DMNShape id="DMNShape_DecisionService_Approval" dmnElementRef="DecisionService_Approval">
        <dc:Bounds x="80" y="80" width="300" height="260" />
        <dmndi:DMNDecisionServiceDividerLine>
          <di:waypoint x="80" y="220" />
          <di:waypoint x="380" y="220" />
        </dmndi:DMNDecisionServiceDividerLine>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="DMNShape_Decision_Approval" dmnElementRef="Decision_Approval">
        <dc:Bounds x="120" y="110" width="180" height="80" />
      </dmndi:DMNShape>
      <dmndi:DMNShape id="DMNShape_Decision_Risk" dmnElementRef="Decision_Risk">
        <dc:Bounds x="120" y="250" width="180" height="80" />
      </dmndi:DMNShape>
      <dmndi:DMNShape id="DMNShape_InputData_Amount" dmnElementRef="InputData_Amount">
        <dc:Bounds x="120" y="420" width="125" height="60" />
      </dmndi:DMNShape>
      <dmndi:DMNShape id="DMNShape_KnowledgeSource_Policy" dmnElementRef="KnowledgeSource_Policy">
        <dc:Bounds x="460" y="100" width="100" height="63" />
      </dmndi:DMNShape>
      <dmndi:DMNShape id="DMNShape_Decision_Standalone" dmnElementRef="Decision_Standalone">
        <dc:Bounds x="460" y="240" width="180" height="80" />
      </dmndi:DMNShape>
      <dmndi:DMNShape id="DMNShape_BKM_Instalment" dmnElementRef="BKM_Instalment">
        <dc:Bounds x="460" y="420" width="135" height="46" />
      </dmndi:DMNShape>
      <dmndi:DMNShape id="DMNShape_TextAnnotation_Note" dmnElementRef="TextAnnotation_Note">
        <dc:Bounds x="720" y="240" width="125" height="80" />
      </dmndi:DMNShape>
      <dmndi:DMNEdge id="DMNEdge_InformationRequirement_Amount" dmnElementRef="InformationRequirement_Amount">
        <di:waypoint x="182" y="420" />
        <di:waypoint x="182" y="330" />
      </dmndi:DMNEdge>
      <dmndi:DMNEdge id="DMNEdge_KnowledgeRequirement_Instalment" dmnElementRef="KnowledgeRequirement_Instalment">
        <di:waypoint x="527" y="420" />
        <di:waypoint x="550" y="320" />
      </dmndi:DMNEdge>
      <dmndi:DMNEdge id="DMNEdge_AuthorityRequirement_Policy" dmnElementRef="AuthorityRequirement_Policy">
        <di:waypoint x="510" y="163" />
        <di:waypoint x="550" y="240" />
      </dmndi:DMNEdge>
      <dmndi:DMNEdge id="DMNEdge_Association_Note" dmnElementRef="Association_Note">
        <di:waypoint x="640" y="280" />
        <di:waypoint x="720" y="280" />
      </dmndi:DMNEdge>
    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
</definitions>
