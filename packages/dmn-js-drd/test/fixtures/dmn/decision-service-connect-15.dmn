<?xml version="1.0" encoding="UTF-8"?>
<!--
  A decision service beside every other kind of element, so the requirements that may
  run to and from one can be drawn - or refused - one pair at a time.
-->
<definitions xmlns="https://www.omg.org/spec/DMN/20230324/MODEL/"
             xmlns:dmndi="https://www.omg.org/spec/DMN/20230324/DMNDI/"
             xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/"
             xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/"
             id="Definitions_DecisionServiceConnect"
             name="Decision Service Connect"
             namespace="https://example.com/dmn15/decision-service-connect">
  <inputData id="InputData_Amount" name="Amount" />
  <businessKnowledgeModel id="BKM_Instalment" name="Instalment" />
  <knowledgeSource id="KnowledgeSource_Policy" name="Lending Policy" />
  <decision id="Decision_Member" name="Member Decision" />
  <decision id="Decision_Outside" name="Outside Decision" />
  <decisionService id="DecisionService_Rating" name="Rating Service">
    <outputDecision href="#Decision_Member" />
  </decisionService>
  <textAnnotation id="TextAnnotation_Note">
    <text>Reviewed quarterly</text>
  </textAnnotation>
  <dmndi:DMNDI>
    <dmndi:DMNDiagram id="DMNDiagram_DecisionServiceConnect">
      <dmndi:DMNShape id="DMNShape_DecisionService_Rating" dmnElementRef="DecisionService_Rating">
        <dc:Bounds x="100" y="300" width="300" height="200" />
        <dmndi:DMNDecisionServiceDividerLine>
          <di:waypoint x="100" y="420" />
          <di:waypoint x="400" y="420" />
        </dmndi:DMNDecisionServiceDividerLine>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="DMNShape_Decision_Member" dmnElementRef="Decision_Member">
        <dc:Bounds x="130" y="330" width="180" height="70" />
      </dmndi:DMNShape>
      <dmndi:DMNShape id="DMNShape_Decision_Outside" dmnElementRef="Decision_Outside">
        <dc:Bounds x="130" y="100" width="180" height="70" />
      </dmndi:DMNShape>
      <dmndi:DMNShape id="DMNShape_BKM_Instalment" dmnElementRef="BKM_Instalment">
        <dc:Bounds x="460" y="100" width="135" height="46" />
      </dmndi:DMNShape>
      <dmndi:DMNShape id="DMNShape_KnowledgeSource_Policy" dmnElementRef="KnowledgeSource_Policy">
        <dc:Bounds x="460" y="220" width="100" height="63" />
      </dmndi:DMNShape>
      <dmndi:DMNShape id="DMNShape_InputData_Amount" dmnElementRef="InputData_Amount">
        <dc:Bounds x="460" y="340" width="125" height="45" />
      </dmndi:DMNShape>
      <dmndi:DMNShape id="DMNShape_TextAnnotation_Note" dmnElementRef="TextAnnotation_Note">
        <dc:Bounds x="700" y="300" width="125" height="80" />
      </dmndi:DMNShape>
    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
</definitions>
