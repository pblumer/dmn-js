<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20230324/MODEL/"
             namespace="https://example.com/dmn15/filter"
             name="FilterExpressions" id="Definitions_Filter">
  <decision id="Decision_Filter" name="PositiveNumbers">
    <variable name="PositiveNumbers" typeRef="list&lt;number&gt;"/>
    <filter>
      <in>
        <literalExpression><text>[-1, 0, 2, 3]</text></literalExpression>
      </in>
      <match>
        <literalExpression><text>item &gt; 0</text></literalExpression>
      </match>
    </filter>
  </decision>
</definitions>
